<div id="toast"></div>

<script>
var DB={get:function(k){try{return JSON.parse(localStorage.getItem(k));}catch(e){return null;}},set:function(k,v){localStorage.setItem(k,JSON.stringify(v));},push:function(k,v){var a=DB.get(k)||[];a.push(v);DB.set(k,a);return a;}};
var exBlocks=[];
var m3Base='roti';
var m3Prot='chicken';
var todayKey='';
var mealData={1:null,2:null,3:null,4:null};

function init(){
  var today=new Date();
  todayKey=today.toISOString().split('T')[0];
  ['l-date','s-date','n-date','st-date'].forEach(function(id){var el=document.getElementById(id);if(el)el.value=todayKey;});
  document.getElementById('hdr-date').textContent=today.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short'});
  var ws=new Date(today);ws.setDate(today.getDate()-today.getDay()+1);
  var we=new Date(ws);we.setDate(ws.getDate()+6);
  document.getElementById('week-range').textContent=ws.getDate()+' - '+we.getDate()+' '+we.toLocaleDateString('en-GB',{month:'short'});
  restoreTodayMeals();
  refreshDash();
  renderHistory();
}

function go(name,el){
  document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});
  document.querySelectorAll('.ni').forEach(function(n){n.classList.remove('active');});
  document.getElementById('sc-'+name).classList.add('active');
  if(el)el.classList.add('active');
  if(name==='dash')refreshDash();
  if(name==='steps')renderHistory();
}

function chip(el,groupId){document.querySelectorAll('#'+groupId+' .chip').forEach(function(c){c.classList.remove('on');});el.classList.add('on');}
function chipVal(groupId){var sel=document.querySelector('#'+groupId+' .chip.on');return sel?sel.dataset.v:'';}

function refreshDash(){
  var sessions=DB.get('sessions')||[];
  var nutrition=DB.get('nutrition')||[];
  var steps=DB.get('steps')||[];
  var strength=DB.get('strength')||[];
  if(sessions.length){var l=sessions[sessions.length-1];document.getElementById('k-wt').textContent=l.bw||'-';document.getElementById('hdr-wt').textContent=(l.bw||'')+' kg';}
  var today=new Date();today.setHours(23,59,59,0);
  var ws=new Date(today);ws.setDate(today.getDate()-today.getDay()+1);ws.setHours(0,0,0,0);
  var wkSess=sessions.filter(function(s){var d=new Date(s.date);return d>=ws&&d<=today;});
  document.getElementById('k-sessions').textContent=wkSess.length;
  if(steps.length){var ls=steps[steps.length-1].steps||0;document.getElementById('k-steps').textContent=ls>=1000?(ls/1000).toFixed(1)+'k':ls;document.getElementById('pg-s').style.width=Math.min(100,(ls/10000)*100)+'%';document.getElementById('pg-s-txt').textContent=ls.toLocaleString();}
  var wkNut=nutrition.filter(function(n){var d=new Date(n.date);return d>=ws&&d<=today;});
  if(wkNut.length){var avgCal=Math.round(wkNut.reduce(function(s,n){return s+(n.calories||0);},0)/wkNut.length);var avgProt=Math.round(wkNut.reduce(function(s,n){return s+(n.protein||0);},0)/wkNut.length);document.getElementById('k-cal').textContent=avgCal;document.getElementById('k-prot').textContent=avgProt+'g';document.getElementById('pg-p').style.width=Math.min(100,(avgProt/190)*100)+'%';document.getElementById('pg-p-txt').textContent=avgProt+'g';}
  document.getElementById('pg-w').style.width=Math.min(100,(wkSess.length/5)*100)+'%';document.getElementById('pg-w-txt').textContent=wkSess.length+'/5';
  var avgP=wkNut.length?Math.round(wkNut.reduce(function(s,n){return s+(n.protein||0);},0)/wkNut.length):0;
  var onTrack=wkSess.length>=4&&avgP>=150;
  var bn=document.getElementById('banner');bn.textContent=onTrack?'ON TRACK':'PUSH MORE';bn.className='banner '+(onTrack?'good':'bad');
  var best={};strength.forEach(function(s){if(!best[s.exercise]||s.weight>best[s.exercise])best[s.exercise]=s.weight;});
  var liftEl=document.getElementById('best-lifts');var keys=Object.keys(best);
  if(keys.length){liftEl.innerHTML=keys.map(function(ex){return '<div class="lift-row"><div class="lift-name">'+ex+'</div><div><span class="lift-kg">'+best[ex]+'</span> <span class="lift-unit">kg</span></div></div>';}).join('');}
  else{liftEl.innerHTML='<div class="empty">Log your first session to see records</div>';}
}

function saveSession(){
  var date=document.getElementById('l-date').value;var bw=document.getElementById('l-bw').value;
  if(!date||!bw){toast('Date and body weight required','err');return;}
  var sess={date:date,bw:parseFloat(bw),type:chipVal('wtype-chips'),duration:document.getElementById('l-dur').value||60,intensity:document.getElementById('l-int').value||8,boxing:document.getElementById('l-box').value||5,stairmaster:document.getElementById('l-stair').value||0,steps:document.getElementById('l-steps').value||0,boxingDone:chipVal('box-chips'),cardioDone:chipVal('cardio-chips'),notes:document.getElementById('l-notes').value,ts:Date.now()};
  DB.push('sessions',sess);
  apiPost('logWorkout',{date:sess.date,bodyWeight:sess.bw,workoutType:sess.type,notes:sess.notes,duration:sess.duration,intensity:sess.intensity,boxingRounds:sess.boxing,boxingDone:sess.boxingDone,cardioDone:sess.cardioDone,steps:sess.steps});
  toast('Session logged','ok');document.getElementById('l-notes').value='';document.getElementById('l-bw').value='';refreshDash();
}

function getLastSession(exerciseName, sessionType){
  var allStr = DB.get('strength') || [];
  var matching = allStr.filter(function(s){ return s.exercise === exerciseName && s.type === sessionType; });
  if(!matching.length) return null;
  var lastDate = matching.map(function(s){ return s.date; }).sort().reverse()[0];
  return { date: lastDate, sets: matching.filter(function(s){ return s.date === lastDate; }) };
}

function addEx(){
  var name = document.getElementById('s-ex').value;
  var sessionType = document.getElementById('s-type').value;
  var id = 'ex' + Date.now();
  exBlocks.push({id:id, name:name, sets:[]});

  var last = getLastSession(name, sessionType);
  var lastHtml = '';
  if(last && last.sets.length){
    var setsText = last.sets.map(function(s,i){
      return '<span style="background:rgba(0,212,170,.12);border-radius:5px;padding:2px 7px;margin:2px;display:inline-block">Set '+(i+1)+': <strong>'+s.weight+'kg</strong> x '+s.reps+'</span>';
    }).join('');
    lastHtml = '<div style="background:rgba(0,212,170,.06);border:1px solid rgba(0,212,170,.2);border-radius:8px;padding:9px 11px;margin-bottom:10px">'
      +'<div style="font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--teal);margin-bottom:5px">Last session '+last.date+'</div>'
      +'<div style="line-height:1.8;font-size:12px;color:var(--text)">'+setsText+'</div></div>';
  } else {
    lastHtml = '<div style="background:rgba(90,90,114,.06);border:1px solid rgba(90,90,114,.2);border-radius:8px;padding:8px 11px;margin-bottom:10px;font-size:11px;color:var(--muted)">No previous data for this exercise</div>';
  }

  var c = document.getElementById('ex-blocks');
  var d = document.createElement('div');
  d.className = 'ex-block'; d.id = id;
  d.innerHTML = '<div class="ex-hd"><div class="ex-name">'+name+'</div><button class="add-set-btn" onclick="addSet(''+id+'')">+ Set</button></div>'
    + lastHtml + '<div id="sets-'+id+'"></div>';
  c.appendChild(d);
  addSet(id);

  // Pre-fill placeholders from last session
  if(last && last.sets.length){
    setTimeout(function(){
      var block = exBlocks.find(function(b){ return b.id === id; });
      if(block && block.sets.length && last.sets[0]){
        var wEl = document.getElementById(block.sets[0]+'-w');
        var rEl = document.getElementById(block.sets[0]+'-r');
        if(wEl) wEl.placeholder = last.sets[0].weight+'kg';
        if(rEl) rEl.placeholder = last.sets[0].reps+' reps';
      }
    }, 50);
  }

  document.getElementById('s-save').style.display = 'flex';
}

function addSet(bid){
  var block=exBlocks.find(function(b){return b.id===bid;});if(!block)return;
  var sn=block.sets.length+1;var sid='set-'+bid+'-'+sn;block.sets.push(sid);
  var c=document.getElementById('sets-'+bid);var d=document.createElement('div');
  d.className='set-row';d.id=sid;

  var sessionType=document.getElementById('s-type').value;
  var blockEl=document.getElementById(bid);
  var exName=blockEl?blockEl.querySelector('.ex-name').textContent:'';
  var last=getLastSession(exName,sessionType);
  var lastSet=last&&last.sets[sn-1]?last.sets[sn-1]:null;
  var wPH=lastSet?lastSet.weight+'kg':'kg';
  var rPH=lastSet?lastSet.reps+' reps':'reps';

  d.innerHTML='<div class="set-n">'+sn+'</div><div class="set-f"><input class="set-i" type="number" placeholder="'+wPH+'" id="'+sid+'-w" step="0.5"><div class="set-lbl">WEIGHT</div></div><div class="set-f"><input class="set-i" type="number" placeholder="'+rPH+'" id="'+sid+'-r"><div class="set-lbl">REPS</div></div><button class="del-set" onclick="delSet(''+sid+'',''+bid+'')">x</button>';
  c.appendChild(d);
}

function delSet(sid,bid){var el=document.getElementById(sid);if(el)el.remove();var b=exBlocks.find(function(b){return b.id===bid;});if(b)b.sets=b.sets.filter(function(s){return s!==sid;});}

function saveStrength(){
  var date=document.getElementById('s-date').value;var type=document.getElementById('s-type').value;
  if(!date){toast('Select a date','err');return;}
  var saved=0;var allStr=DB.get('strength')||[];
  exBlocks.forEach(function(block){block.sets.forEach(function(sid,idx){var wEl=document.getElementById(sid+'-w');var rEl=document.getElementById(sid+'-r');if(wEl&&rEl&&wEl.value&&rEl.value){var w=parseFloat(wEl.value);var r=parseInt(rEl.value);var oneRM=Math.round(w*(1+r/30)*10)/10;var prevBest=allStr.filter(function(s){return s.exercise===block.name;}).reduce(function(mx,s){return Math.max(mx,s.weight);},0);allStr.push({date:date,exercise:block.name,weight:w,reps:r,setNum:idx+1,type:type,oneRM:oneRM,best:w>=prevBest,ts:Date.now()});saved++;}});});
  DB.set('strength',allStr);apiPost('logStrength',{date:date,sets:allStr.slice(-saved),sessionNum:Date.now()});toast(saved+' sets saved','ok');document.getElementById('ex-blocks').innerHTML='';exBlocks=[];document.getElementById('s-save').style.display='none';refreshDash();
}

function restoreTodayMeals(){var saved=DB.get('meals-'+todayKey);if(saved){mealData=saved;updateMealUI();updateNutTotal();}}

function logMeal(num,prot,cal,carbs,fat){mealData[num]={protein:prot,calories:cal,carbs:carbs,fat:fat};saveMeals();updateMealUI();updateNutTotal();toast('Meal '+num+' logged','ok');}

function logMeal3(){
  var prot=m3Prot;var protein=prot==='lentils'?37:45;var calories=(prot==='lentils'?520:550)+(m3Base==='rice'?30:0);var carbs=m3Base==='rice'?70:45;
  document.getElementById('m3-macros').textContent=protein+'g protein - '+calories+' kcal';
  logMeal(3,protein,calories,carbs,18);
}

function swapBase(v){m3Base=v;document.getElementById('sw-roti').className='swap-btn'+(v==='roti'?' active':'');document.getElementById('sw-rice').className='swap-btn'+(v==='rice'?' active':'');}
function swapProt(v){m3Prot=v;['chicken','lentils','lamb'].forEach(function(p){document.getElementById('sw-'+p).className='swap-btn'+(v===p?' active':'');});}

function updateMealUI(){[1,2,3,4].forEach(function(n){var b=document.getElementById('m'+n+'-badge');if(b){b.textContent=mealData[n]?'Logged':'Not logged';b.className='meal-logged '+(mealData[n]?'yes':'no');}});}

function updateNutTotal(){
  var tc=0,tp=0;[1,2,3,4].forEach(function(n){if(mealData[n]){tc+=mealData[n].calories||0;tp+=mealData[n].protein||0;}});
  document.getElementById('nt-cal').textContent=tc;document.getElementById('nt-prot').textContent=tp+'g';
  document.getElementById('nt-prog').style.width=Math.min(100,(tc/2065)*100)+'%';
  if(mealData[1]&&mealData[2]&&mealData[3]&&mealData[4]){var water=parseFloat(document.getElementById('n-water').value)||0;var nut=DB.get('nutrition')||[];var date=document.getElementById('n-date').value;var idx=nut.findIndex(function(n){return n.date===date;});var rec={date:date,calories:tc,protein:tp,water:water,ts:Date.now()};if(idx>=0)nut[idx]=rec;else nut.push(rec);DB.set('nutrition',nut);}
}

function saveMeals(){DB.set('meals-'+todayKey,mealData);}
function resetMeals(){mealData={1:null,2:null,3:null,4:null};DB.set('meals-'+todayKey,mealData);updateMealUI();updateNutTotal();toast('Meals reset','ok');}

function updateStepsPrev(){var s=parseInt(document.getElementById('st-steps').value)||0;document.getElementById('st-prog').style.width=Math.min(100,(s/10000)*100)+'%';var el=document.getElementById('st-status');el.textContent=s>=10000?'Goal met!':(s>0?s.toLocaleString()+' / 10000':'-');el.style.color=s>=10000?'var(--green)':(s>0?'var(--gold)':'var(--muted)');}

function saveSteps(){
  var date=document.getElementById('st-date').value;var steps=parseInt(document.getElementById('st-steps').value)||0;
  if(!date){toast('Select a date','err');return;}
  var all=DB.get('steps')||[];var idx=all.findIndex(function(s){return s.date===date;});
  var rec={date:date,steps:steps,stairmaster:document.getElementById('st-stair').value||0,boxing:document.getElementById('st-box').value||0,other:document.getElementById('st-other').value||'',ts:Date.now()};
  if(idx>=0)all[idx]=rec;else all.push(rec);DB.set('steps',all);
  apiPost('logSteps',{date:date,steps:steps,stairmaster:document.getElementById('st-stair').value||0,boxing:document.getElementById('st-box').value||0,otherCardio:document.getElementById('st-other').value||''});
  toast('Steps logged','ok');refreshDash();renderHistory();
}

function renderHistory(){
  var sessions=(DB.get('sessions')||[]).slice().reverse().slice(0,15);var el=document.getElementById('hist-list');
  if(!sessions.length){el.innerHTML='<div class="empty">No sessions logged yet</div>';return;}
  el.innerHTML=sessions.map(function(s){var ok=parseInt(s.steps)>=10000;return '<div class="hist-item"><div><div class="hist-main">'+s.type+' - '+s.bw+'kg</div><div class="hist-sub">'+s.date+' - '+s.duration+'min - Intensity '+s.intensity+'/10</div></div><div class="badge '+(ok?'badge-g':'badge-r')+'">'+(ok?'Steps OK':'Steps Low')+'</div></div>';}).join('');
}

function exportCSV(){
  var sessions=DB.get('sessions')||[];var nutrition=DB.get('nutrition')||[];var strength=DB.get('strength')||[];var steps=DB.get('steps')||[];
  var csv='SESSIONS\nDate,Type,Body Weight,Duration,Intensity,Boxing Done,Cardio Done,Steps\n';
  sessions.forEach(function(s){csv+=[s.date,s.type,s.bw,s.duration,s.intensity,s.boxingDone,s.cardioDone,s.steps].join(',')+'\n';});
  csv+='\nNUTRITION\nDate,Calories,Protein,Water\n';
  nutrition.forEach(function(n){csv+=[n.date,n.calories,n.protein,n.water].join(',')+'\n';});
  csv+='\nSTRENGTH\nDate,Exercise,Weight,Reps,Set,1RM,Best\n';
  strength.forEach(function(s){csv+=[s.date,s.exercise,s.weight,s.reps,s.setNum,s.oneRM,s.best?'YES':''].join(',')+'\n';});
  csv+='\nSTEPS\nDate,Steps,Stairmaster,Boxing\n';
  steps.forEach(function(s){csv+=[s.date,s.steps,s.stairmaster,s.boxing].join(',')+'\n';});
  var blob=new Blob([csv],{type:'text/csv'});var url=URL.createObjectURL(blob);var a=document.createElement('a');a.href=url;a.download='peak-'+todayKey+'.csv';a.click();URL.revokeObjectURL(url);toast('CSV exported','ok');
}

function showSetup(){
  var url = localStorage.getItem('peak_url')||'';
  document.getElementById('setup-url').value = url;
  var status = document.getElementById('conn-status');
  if(url){ status.textContent='Connected: '+url.substring(0,50)+'...'; status.style.color='var(--teal)'; }
  else { status.textContent='Not connected - using local storage only'; status.style.color='var(--muted)'; }
  document.getElementById('setup-overlay').style.display='block';
}

function closeSetup(){
  document.getElementById('setup-overlay').style.display='none';
}

function saveSetup(){
  var url = document.getElementById('setup-url').value.trim();
  var statusEl = document.getElementById('setup-status');
  if(!url || !url.includes('script.google.com')){
    statusEl.textContent='Enter a valid Apps Script URL';
    statusEl.style.color='var(--red)';
    return;
  }
  localStorage.setItem('peak_url', url);
  statusEl.textContent='Connected successfully';
  statusEl.style.color='var(--teal)';
  var connEl = document.getElementById('conn-status');
  connEl.textContent='Connected: '+url.substring(0,50)+'...';
  connEl.style.color='var(--teal)';
  setTimeout(function(){ closeSetup(); toast('Google Sheets connected','ok'); }, 1000);
}

async function apiPost(action, payload){
  var url = localStorage.getItem('peak_url');
  if(!url) return null;
  try{
    var res = await fetch(url, { method:'POST', body:JSON.stringify({action:action,payload:payload}), headers:{'Content-Type':'text/plain'} });
    return await res.json();
  } catch(e){ return null; }
}

function toast(msg,type){var t=document.getElementById('toast');t.textContent=msg;t.className='show '+(type||'ok');clearTimeout(window._tt);window._tt=setTimeout(function(){t.className='';},2500);}

init();
</script>
</body>
</html>
