  <div class="ni active" onclick="go('dash',this)"><div class="ni-icon">&#9889;</div><div class="ni-lbl">Home</div></div>
  <div class="ni" onclick="go('log',this)"><div class="ni-icon">&#128203;</div><div class="ni-lbl">Session</div></div>
  <div class="ni" onclick="go('str',this)"><div class="ni-icon">&#128170;</div><div class="ni-lbl">Lifts</div></div>
  <div class="ni" onclick="go('nut',this)"><div class="ni-icon">&#129367;</div><div class="ni-lbl">Nutrition</div></div>
  <div class="ni" onclick="go('steps',this)"><div class="ni-icon">&#128609;</div><div class="ni-lbl">Steps</div></div>
</div>
