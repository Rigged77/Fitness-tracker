    <div class="row2"><div><span class="lbl">Boxing Rounds</span><input type="number" id="st-box" placeholder="5"></div><div><span class="lbl">Other Cardio</span><input type="text" id="st-other" placeholder="e.g. Run"></div></div>
    <div class="card" style="margin:0 0 13px;padding:13px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:7px"><span style="font-size:13px">Steps goal 10000</span><span id="st-status" style="font-size:13px;color:var(--muted)">-</span></div>
